        "select_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Select Score"
        },
        "fit_time_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fit Time S"
        },
        "loc": {
          "default": 0,
          "title": "Loc",
          "type": "integer"
        },
        "repair_attempts": {
          "default": 0,
          "title": "Repair Attempts",
          "type": "integer"
        },
        "error_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Kind"
        },
        "error_tail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Tail"
        },
        "llm_calls": {
          "items": {
            "$ref": "#/$defs/LLMUsage"
          },
          "title": "Llm Calls",
          "type": "array"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "duration_s": {
          "default": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "started_at": {
          "default": "",
          "title": "Started At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "parent_id",
        "idea",
        "code",
        "status"
      ],
      "title": "ExperimentRecord",
      "type": "object"
    },
    "FinalScores": {
      "properties": {
        "best_exp_id": {
          "title": "Best Exp Id",
          "type": "string"
        },
        "dev_cv_mean": {
          "title": "Dev Cv Mean",
          "type": "number"
        },
        "select_score": {
          "title": "Select Score",
          "type": "number"
        },
        "test_score": {
          "title": "Test Score",
          "type": "number"
        },
        "optimism_gap": {
          "title": "Optimism Gap",
          "type": "number"
        }
      },
      "required": [
        "best_exp_id",
        "dev_cv_mean",
        "select_score",
        "test_score",
        "optimism_gap"
      ],
      "title": "FinalScores",
      "type": "object"
    },
    "Idea": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/IdeaCategory"
        },
        "radical": {
          "default": false,
          "title": "Radical",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "category"
      ],
      "title": "Idea",
      "type": "object"
    },
    "IdeaCategory": {
      "enum": [
        "baseline",
        "preprocessing",
        "feature_engineering",
        "model_family",
        "hyperparameters",
        "ensembling",
        "simplification",
        "repair"
      ],
      "title": "IdeaCategory",
      "type": "string"
    },
    "LLMUsage": {
      "properties": {
        "purpose": {
          "enum": [
            "draft",
            "propose",
            "implement",
            "repair"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "default": 0.0,
          "title": "Cost Usd",
          "type": "number"
        },
        "latency_s": {
          "default": 0.0,
          "title": "Latency S",
          "type": "number"
        }
      },
      "required": [
        "purpose",
        "model"
      ],
      "title": "LLMUsage",
      "type": "object"
    },
    "Metric": {
      "enum": [
        "roc_auc",
        "log_loss",
        "accuracy",
        "f1_macro",
        "rmse",
        "mae",
        "r2"
      ],
      "title": "Metric",
      "type": "string"
    },
    "ProblemType": {
      "enum": [
        "binary",
        "multiclass",
        "regression"
      ],
      "title": "ProblemType",
      "type": "string"
    },
    "TaskSpec": {
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "problem_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProblemType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "metric": {
          "anyOf": [
            {
              "$ref": "#/$defs/Metric"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        },
        "cv_folds": {
          "default": 5,
          "title": "Cv Folds",
          "type": "integer"
        },
        "cv_repeats": {
          "default": 2,
          "title": "Cv Repeats",
          "type": "integer"
        },
        "select_frac": {
          "default": 0.15,
          "title": "Select Frac",
          "type": "number"
        },
        "test_frac": {
          "default": 0.15,
          "title": "Test Frac",
          "type": "number"
        },
        "experiment_timeout_s": {
          "default": 120.0,
          "title": "Experiment Timeout S",
          "type": "number"
        },
        "experiment_memory_mb": {
          "default": 2048,
          "title": "Experiment Memory Mb",
          "type": "integer"
        }
      },
      "required": [
        "target"
      ],
      "title": "TaskSpec",
      "type": "object"
    }
