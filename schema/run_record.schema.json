{
  "$defs": {
    "CVScore": {
      "properties": {
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "se": {
          "title": "Se",
          "type": "number"
        },
        "folds": {
          "items": {
            "type": "number"
          },
          "title": "Folds",
          "type": "array"
        }
      },
      "required": [
        "mean",
        "se",
        "folds"
      ],
      "title": "CVScore",
      "type": "object"
    },
    "ColumnKind": {
      "enum": [
        "numeric",
        "categorical",
        "boolean",
        "datetime",
        "text",
        "id",
        "constant"
      ],
      "title": "ColumnKind",
      "type": "string"
    },
    "ColumnProfile": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ColumnKind"
        },
        "missing_frac": {
          "title": "Missing Frac",
          "type": "number"
        },
        "n_unique": {
          "title": "N Unique",
          "type": "integer"
        },
        "examples": {
          "items": {},
          "title": "Examples",
          "type": "array"
        },
        "stats": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stats"
        },
        "top_values": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Values"
        },
        "flags": {
          "items": {
            "type": "string"
          },
          "title": "Flags",
          "type": "array"
        }
      },
      "required": [
        "name",
        "dtype",
        "kind",
        "missing_frac",
        "n_unique"
      ],
      "title": "ColumnProfile",
      "type": "object"
    },
    "DataProfile": {
      "properties": {
        "n_rows": {
          "title": "N Rows",
          "type": "integer"
        },
        "n_cols": {
          "title": "N Cols",
          "type": "integer"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "problem_type": {
          "$ref": "#/$defs/ProblemType"
        },
        "metric": {
          "$ref": "#/$defs/Metric"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnProfile"
          },
          "title": "Columns",
          "type": "array"
        },
        "target_summary": {
          "additionalProperties": true,
          "title": "Target Summary",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "sample_rows": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Sample Rows",
          "type": "array"
        }
      },
      "required": [
        "n_rows",
        "n_cols",
        "target",
        "problem_type",
        "metric",
        "columns",
        "target_summary"
      ],
      "title": "DataProfile",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "keep",
        "discard",
        "crash"
      ],
      "title": "Decision",
      "type": "string"
    },
    "ExperimentRecord": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "idea": {
          "$ref": "#/$defs/Idea"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "diff": {
          "default": "",
          "title": "Diff",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Decision"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "cv": {
          "anyOf": [
            {
              "$ref": "#/$defs/CVScore"
            },
            {
              "type": "null"
            }
          ],
          "default": null
