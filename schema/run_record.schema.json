  "properties": {
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "mode": {
      "title": "Mode",
      "type": "string"
    },
    "proposer": {
      "title": "Proposer",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskSpec"
    },
    "profile": {
      "$ref": "#/$defs/DataProfile"
    },
    "config": {
      "additionalProperties": true,
      "title": "Config",
      "type": "object"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/ExperimentRecord"
      },
      "title": "Experiments",
      "type": "array"
    },
    "best_exp_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Best Exp Id"
    },
    "stop": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Stop"
    },
    "final": {
      "anyOf": [
        {
          "$ref": "#/$defs/FinalScores"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "total_cost_usd": {
      "default": 0.0,
      "title": "Total Cost Usd",
      "type": "number"
    },
    "total_input_tokens": {
      "default": 0,
      "title": "Total Input Tokens",
      "type": "integer"
    },
    "total_output_tokens": {
      "default": 0,
      "title": "Total Output Tokens",
      "type": "integer"
    },
    "wall_time_s": {
      "default": 0.0,
      "title": "Wall Time S",
      "type": "number"
    }
  },
  "required": [
    "run_id",
    "created_at",
    "mode",
    "proposer",
    "task",
    "profile"
  ],
  "title": "RunRecord",
  "type": "object"
}
