# The backend reads the process environment; in local dev it also reads the repo-root .env and web/.env.local
# (never overriding what is already set). On Vercel, set these as the project's environment variables.
# Never commit real values.

# ---- required ------------------------------------------------------------------
# Neon Postgres. The pooled URL (PgBouncer) is used for requests; migrations prefer DATABASE_URL_UNPOOLED/DATABASE_URL.
DATABASE_URL_POOLED=
DATABASE_URL=
# Signs the anonymous owner cookie (32+ chars; e.g. `openssl rand -base64 32`). Same value as the old Next.js backend.
AUTOTINKER_SESSION_SECRET=
# LLM providers (the engine and the preview's suggestion call). In the sandbox they are injected by the firewall.
GROQ_API_KEY=
GEMINI_API_KEY=
# CEREBRAS_API_KEY=

# ---- runner ----------------------------------------------------------------------
# local (default off-Vercel) | sandbox (default on Vercel)
# AUTOTINKER_RUNNER=local
# Set to 0 for a replays-only deployment (POST /api/runs returns 503).
# AUTOTINKER_LIVE_RUNS=1
# local runner: the Python command (split on whitespace); default `uv run --project <repo root> python`.
# AUTOTINKER_PYTHON_CMD=
# AUTOTINKER_RUN_TIMEOUT_S=3600
# AUTOTINKER_MAX_CONCURRENT_RUNS=2
# AUTOTINKER_DATA_DIR=backend/.data

# ---- sandbox runner ----------------------------------------------------------------
# Where the sandbox posts events (default: the host of the request that started the run).
# AUTOTINKER_PUBLIC_URL=https://<your-app>.vercel.app
# Lets the sandbox reach the ingest route through Deployment Protection (brokered by the sandbox firewall).
# VERCEL_AUTOMATION_BYPASS_SECRET=
# pip spec of the engine inside the VM (pin a commit for reproducible snapshots).
# AUTOTINKER_SANDBOX_PACKAGE=autotinker @ git+https://github.com/Sakalya100/AutoTabML@v2
# VM limit in minutes (Hobby max 45); the engine gets --max-time = limit - 3 min.
# AUTOTINKER_SANDBOX_MINUTES=40
# AUTOTINKER_SANDBOX_VCPUS=2
# Reuse an installed-engine snapshot: 0 disables; a pinned id overrides the one stored in app_settings.
# AUTOTINKER_SANDBOX_SNAPSHOTS=1
# AUTOTINKER_SANDBOX_SNAPSHOT_ID=
# AUTOTINKER_SANDBOX_SNAPSHOT_DAYS=30
# Providers the engine should not use inside the sandbox (comma-separated).
# AUTOTINKER_DISABLED_PROVIDERS=

# ---- run files (model + pipeline code downloads) ------------------------------------------
# Vercel Blob read-write token of a PRIVATE store (set automatically when the store is connected to the project).
# Unset: local runs keep their files on this disk and serve them from there; sandbox runs can't keep files (they are
# listed as "not saved"). Never sent to the sandbox VM: it gets one presigned, size-capped PUT URL per file instead.
# BLOB_READ_WRITE_TOKEN=
# Files larger than this are listed but not stored (default 100).
# AUTOTINKER_MAX_ASSET_MB=100
# 1 = add download=1 to the presigned download URL (attachment instead of inline; unverified on private stores).
# AUTOTINKER_BLOB_DOWNLOAD_PARAM=0
# Blob API base (testing only; also added to the sandbox allow-list). Default https://vercel.com/api/blob
# VERCEL_BLOB_API_URL=

# ---- limits ------------------------------------------------------------------------
# AUTOTINKER_RUNS_PER_IP_PER_HOUR=3
# AUTOTINKER_RUNS_PER_OWNER_PER_HOUR=3
# AUTOTINKER_PREVIEWS_PER_MIN=20
# Watchdog: a run with no event or heartbeat for this long is marked timed_out.
# AUTOTINKER_STALL_MINUTES=10
# One SSE connection's lifetime (the browser reconnects with Last-Event-ID).
# AUTOTINKER_SSE_MAX_S=280
