# The web app is frontend-only; the API is the FastAPI service in backend/ (see backend/.env.example).
# Copy to .env.local if you need either variable.

# Where `next dev` proxies /api/* (dev only; on Vercel the root vercel.json routes /api/* to the backend).
# AUTOTINKER_API_URL=http://127.0.0.1:8000

# Set to 0 for a replays-only deployment (hides the Start button; set it on the backend too).
# AUTOTINKER_LIVE_RUNS=0

# The backend reads AUTOTINKER_SESSION_SECRET (and DATABASE_URL*) from this file in local dev, so existing browser
# sessions keep working. The frontend itself no longer uses them.
