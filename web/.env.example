# Copy to .env.local. Every variable is optional for local development.

# ---- runner -------------------------------------------------------------------
# local (default off-Vercel) | vercel-sandbox (default on Vercel)
AUTOTABML_RUNNER=local
# Set to 0 for a replays-only deployment (POST /api/runs returns 503).
AUTOTABML_LIVE_RUNS=1
# local runner: command that runs Python with the autotabml package importable. Split on whitespace.
# Default: uv run --project <repo root> python
# AUTOTABML_PYTHON_CMD=uv run --project /path/to/AutoTabML python
# Kill a local run after this many seconds.
AUTOTABML_RUN_TIMEOUT_S=3600
AUTOTABML_MAX_CONCURRENT_RUNS=2
# Live runs started per client IP per hour (in-memory; per server instance).
AUTOTABML_RUNS_PER_IP_PER_HOUR=3
# Set to 0 if the engine CLI does not accept --description.
AUTOTABML_PASS_DESCRIPTION=1
# Where the file store and local uploads live (default: web/.data).
# AUTOTABML_DATA_DIR=

# ---- LLM ----------------------------------------------------------------------
# Value passed as --llm when the user picks Anthropic (default "anthropic:" = the engine's default Anthropic model).
# AUTOTABML_ANTHROPIC_LLM_SPEC=anthropic:
# Hard LLM spend cap per run, passed as --max-cost (USD).
AUTOTABML_MAX_COST_USD=1
# Optional capped demo key used when a visitor picks Anthropic without pasting their own key.
# Leave unset to require BYOK.
# AUTOTABML_SERVER_ANTHROPIC_KEY=

# ---- store --------------------------------------------------------------------
# When both are set, runs/events are stored in Upstash Redis (24h TTL) instead of web/.data. Required on Vercel.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- vercel-sandbox runner (UNTESTED) ------------------------------------------
# Public base URL the sandbox posts events back to (falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL).
# AUTOTABML_PUBLIC_URL=https://autotabml.example.com
# pip requirement for the engine inside the sandbox.
# AUTOTABML_SANDBOX_PACKAGE=autotabml @ git+https://github.com/Sakalya100/AutoTabML@v2
# Session timeout in ms. Hobby max 45 min (2700000), Pro/Enterprise max 24 h.
# AUTOTABML_SANDBOX_TIMEOUT_MS=2700000
# AUTOTABML_SANDBOX_VCPUS=2
# Auth: on Vercel the SDK uses the project's OIDC token automatically. Locally: `vercel link && vercel env pull`.
# VERCEL_OIDC_TOKEN=
